-(defalias 'make-autoload #'loaddefs-generate--make-autoload)
+(defun make-autoload (form file &optional expansion)
+  "Turn FORM into an autoload or defvar for source file FILE.
+FILE is the load name of the source file, without its \".el\" suffix,
+as `loaddefs-generate--make-autoload' took it before it grew a separate
+argument for the full file name; that name is derived from FILE here."
+  (loaddefs-generate--make-autoload form file (concat file ".el") expansion))
 
